          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Produto criado', () => {\r\n  pm.response.to.have.status(201);\r\n  const p = pm.response.json();\r\n  pm.expect(p).to.have.property('_id');\r\n  pm.expect(p.nome).to.eql('Café Torrado 500 g');\r\n  pm.collectionVariables.set('produtoId', p._id);\r\n});"
            ]
          }
        }
